# Copie estas variáveis para o painel da Vercel (Project Settings → Environment Variables).
# NUNCA commite os valores reais.

# ---- Login de clientes (área "Faturas em aberto") ----
# Chave usada para assinar o cookie de sessão do cliente (api/_lib/session.js).
# Obrigatória para o login/cadastro funcionar. Gere um valor aleatório único
# (ex: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# e NUNCA reaproveite/troque depois de configurado — trocar o valor desconecta
# todos os clientes já logados.
SESSION_SECRET=
# Opcional — só precisa preencher se o projeto Supabase mudar. O código já
# tem um valor padrão (mesmo do site) para SUPABASE_URL/SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Integração com a API do Cora (faturas reais) ----
# Enquanto essas 3 variáveis não estiverem preenchidas, /api/faturas devolve
# dados de exemplo (protegidos por login) em vez de consultar a Cora de verdade.
CORA_ENV=production
CORA_CLIENT_ID=
# Cole o certificado e a chave em uma linha só, com \n no lugar das quebras de linha
CORA_CERT=
CORA_KEY=

# Domínio do site que pode chamar este proxy (CORS) — deixe em branco/"*" se
# o site e o proxy estiverem no mesmo domínio (caso padrão aqui).
ALLOWED_ORIGIN=
